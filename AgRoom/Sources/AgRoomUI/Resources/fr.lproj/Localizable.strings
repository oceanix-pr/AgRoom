"help.categories" = "Rubriques d’aide";
"help.faq" = "Questions fréquentes";
"help.faq.citations.desc" = "Développez les sources de connaissances sous la réponse et ouvrez un passage. Les nouvelles réponses conservent l'extrait utilisé à ce moment. « Document actuel » ouvre le texte le plus récent.";
"help.faq.citations.title" = "Comment vérifier les sources de connaissances d'une réponse ?";
"help.faq.data.desc" = "Chaque espace conserve sa propre base de données sous Application Support. Dans Paramètres → Données et sauvegardes, exportez une sauvegarde de l'espace actuel ou activez les sauvegardes automatiques, qui archivent chaque espace séparément.";
"help.faq.data.title" = "Où se trouvent mes données et comment les sauvegarder ?";
"help.faq.files.desc" = "Sélectionnez un dossier de projet dans le chat, ou ajoutez des fichiers via le sélecteur système. L'agent ne peut accéder qu'à l'espace de travail actuel et aux dossiers de référence explicitement autorisés. Les écritures respectent les politiques de permission et de confirmation en cours.";
"help.faq.files.title" = "Comment l'agent lit-il mes fichiers ?";
"help.faq.goal.desc" = "Quand l’état indique «À valider», la carte de l’objectif affiche les critères. Ouvrez le résultat de l’étape, cochez ceux que vous avez vérifiés, puis choisissez «Enregistrer la validation». «Vérifier et continuer» lance une nouvelle étape d’exécution.";
"help.faq.goal.title" = "Comment accepter le résultat d'un objectif ?";
"help.faq.model.desc" = "Vérifiez qu'un fournisseur est configuré et activé dans Paramètres → Services de modèle, et que la clé API est toujours valide.";
"help.faq.model.title" = "L'assistant ne répond pas";
"help.faq.retry.desc" = "La confirmation de réessai affiche l'espace de travail d'origine. Le réessai utilise ses dossiers enregistrés et sa portée de connaissances. Pour les tâches anciennes sans détails de projet, ouvrez la conversation d'origine et exécutez-les à nouveau.";
"help.faq.retry.title" = "Quel projet une tentative de collaboration utilise-t-elle ?";
"help.faq.schedule.desc" = "«Échéance manquée» signifie que le délai de rattrapage est dépassé. «Ignoré» signifie qu’une exécution précédente était encore active. «Annulé» indique qu’un arrêt a été demandé. «Échec» indique que l’exécution s’est terminée par une erreur. Gardez AgRoom ouvert pour exécuter les tâches planifiées.";
"help.faq.schedule.title" = "Comment lire les statuts des exécutions planifiées ?";
"help.faq.skills.desc" = "Décrivez ce qu'il doit faire dans le chat et l'agent rédige un SKILL.md que vous pouvez examiner ; vous pouvez également importer un package existant.";
"help.faq.skills.title" = "Comment créer une compétence ?";
"help.faq.todos.desc" = "Les actions déjà présentes conservent vos modifications, leur état d’achèvement et leur lien avec Rappels. Les échéances relatives sont calculées à partir de la date enregistrée de l’événement. Si cette date est inconnue, la formulation d’origine reste disponible.";
"help.faq.todos.title" = "Que se passe-t-il lorsque j'extrait à nouveau les éléments d'action ?";
"help.firstUse" = "Guide de première utilisation";
"help.firstUse.1.desc" = "Choisissez un espace en haut de la barre latérale. Vos conversations, connaissances, notes et compétences sont enregistrées dans cet espace.";
"help.firstUse.1.title" = "Choisissez Personnel ou Travail";
"help.firstUse.2.desc" = "Ouvrez Réglages → Services de modèles. Ajoutez l’adresse du fournisseur, l’identifiant du modèle et la clé API. Activez le fournisseur, puis testez la connexion pour démarrer la première tâche.";
"help.firstUse.2.title" = "Connectez et testez un modèle";
"help.firstUse.3.desc" = "Commencez par l'exemple dans le guide de la première tâche, ou joignez un fichier texte court. Pour une comparaison, sélectionnez au moins deux fichiers. Vous pouvez ajouter des fichiers de différents dossiers dans des sélections distinctes.";
"help.firstUse.3.title" = "Préparez un document simple";
"help.firstUse.4.desc" = "Choisissez le classement, la comparaison ou le résumé du courrier. Vérifiez le modèle et les sources, puis lancez la tâche. À chaque demande de confirmation, examinez la cible et les modifications proposées avant de les approuver.";
"help.firstUse.4.title" = "Lancez la tâche et vérifiez les opérations";
"help.firstUse.5.desc" = "Ouvrez le rapport depuis sa carte de résultat et comparez-le avec votre source. Utilisez la vérification du premier résultat après l'avoir examiné. La carte prend également en charge l'exportation et l'édition continue.";
"help.firstUse.5.title" = "Ouvrez et vérifiez le résultat";
"help.firstUse.6.desc" = "Consultez les exécutions dans le centre des tâches, rouvrez les rapports dans la bibliothèque des résultats et recherchez dans cet espace avec ⌘K. Pour un résumé du courrier, configurez et synchronisez la boîte. Le guide reprend dès que des messages sont disponibles.";
"help.firstUse.6.title" = "Retrouvez votre travail";
