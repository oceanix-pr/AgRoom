"help.categories" = "Categorías de ayuda";
"help.faq" = "Preguntas frecuentes";
"help.faq.citations.desc" = "Amplía las fuentes de conocimiento debajo de la respuesta y abre un fragmento. Las nuevas respuestas conservan el extracto utilizado en ese momento. «Documento actual» abre el texto más reciente.";
"help.faq.citations.title" = "¿Cómo verifico las fuentes de conocimiento de una respuesta?";
"help.faq.data.desc" = "Cada espacio conserva su propia base de datos dentro de «Soporte de la aplicación». En «Configuración → Datos y copias de seguridad», exporta una copia de seguridad del espacio actual o habilita las copias de seguridad automáticas, que archivan cada espacio por separado.";
"help.faq.data.title" = "¿Dónde están mis datos y cómo hago una copia de seguridad?";
"help.faq.files.desc" = "Selecciona una carpeta del proyecto en el chat o añade archivos a través del selector del sistema. El agente solo puede acceder al espacio de trabajo actual y a las carpetas de referencia autorizadas explícitamente. Las escrituras siguen las políticas de permisos y confirmación vigentes.";
"help.faq.files.title" = "¿Cómo lee el agente mis archivos?";
"help.faq.goal.desc" = "Cuando el estado sea «Pendiente de revisión», la tarjeta del objetivo despliega sus criterios. Abre el resultado de la etapa, marca los criterios comprobados y elige «Guardar la evaluación». «Revisar y continuar» inicia otra etapa de ejecución.";
"help.faq.goal.title" = "¿Cómo acepto el resultado de un objetivo?";
"help.faq.model.desc" = "Verifica que haya un proveedor configurado y habilitado en «Configuración → Servicios de modelos», y que la clave de API siga siendo válida.";
"help.faq.model.title" = "El asistente no responde";
"help.faq.retry.desc" = "La confirmación de reintento muestra el espacio de trabajo original. El reintento utiliza sus carpetas y alcance de conocimiento registrados. Para tareas antiguas sin detalles del proyecto, abre la conversación original y ejecútalas de nuevo.";
"help.faq.retry.title" = "¿Qué proyecto utiliza un reintento de colaboración?";
"help.faq.schedule.desc" = "«Omitido por retraso» indica que ha pasado el plazo de recuperación. «Omitido» indica que una ejecución anterior seguía activa. «Cancelado» indica que se solicitó detener la tarea. «Fallido» indica que la ejecución terminó con un error. Mantén AgRoom abierto para ejecutar las tareas programadas.";
"help.faq.schedule.title" = "¿Cómo leo los estados de las ejecuciones programadas?";
"help.faq.skills.desc" = "Describe en el chat qué debe hacer y el agente redactará un SKILL.md para que lo revises; también puedes importar un paquete existente.";
"help.faq.skills.title" = "¿Cómo creo una habilidad?";
"help.faq.todos.desc" = "Las tareas coincidentes conservan tus cambios, su estado de finalización y el vínculo con Recordatorios. Las fechas relativas se calculan desde la fecha registrada del evento. Si no se conoce, se conserva la expresión original para que la revises.";
"help.faq.todos.title" = "¿Qué sucede cuando extraigo elementos de acción nuevamente?";
"help.firstUse" = "Guía de primer uso";
"help.firstUse.1.desc" = "Elige un espacio en la parte superior de la barra lateral. Tus conversaciones, conocimientos, notas y habilidades se guardan en ese espacio.";
"help.firstUse.1.title" = "Elige Personal o Trabajo";
"help.firstUse.2.desc" = "Abre Ajustes → Servicios de modelos. Añade la dirección del proveedor, el identificador del modelo y la clave API. Activa el proveedor y prueba la conexión para iniciar la primera tarea.";
"help.firstUse.2.title" = "Conecta y prueba un modelo";
"help.firstUse.3.desc" = "Comienza con la muestra en la guía de la primera tarea, o adjunta un archivo de texto corto. Para una comparación, selecciona al menos dos archivos. Puedes añadir archivos de diferentes carpetas en selecciones separadas.";
"help.firstUse.3.title" = "Prepara un archivo sencillo";
"help.firstUse.4.desc" = "Elige Organizar, Comparar o Resumen del correo. Revisa el modelo y las fuentes e inicia la tarea. Cuando se solicite confirmación, revisa el destino y los cambios propuestos antes de aprobarlos.";
"help.firstUse.4.title" = "Ejecuta y revisa las operaciones";
"help.firstUse.5.desc" = "Abre el informe desde su tarjeta de resultado y compáralo con tu fuente. Usa la verificación del primer resultado después de revisarlo. La tarjeta también admite exportación y edición continua.";
"help.firstUse.5.title" = "Abre y revisa el resultado";
"help.firstUse.6.desc" = "Consulta las ejecuciones en el centro de tareas, abre los informes en la biblioteca de resultados y busca en este espacio con ⌘K. Si eliges el resumen del correo, configura y sincroniza el buzón. La guía se reanudará cuando haya mensajes disponibles.";
"help.firstUse.6.title" = "Vuelve a encontrar tu trabajo";
"help.open_settings" = "Abrir ajustes";
"help.privacy" = "Privacidad y datos";
"help.privacy.endpoint" = "Los puntos finales de modelos remotos deben usar HTTPS; el contenido se envía únicamente a los puntos finales que configuraste.";
"help.privacy.keychain" = "Las claves API y las credenciales del correo se guardan solo en el Llavero de macOS y nunca en la base de datos ni en los registros.";
"help.privacy.local" = "Los chats, la memoria y el conocimiento se almacenan en bases de datos locales. Los archivos y archivos adjuntos se guardan en sus carpetas locales correspondientes.";
"help.privacy.spaces" = "Life y Work están físicamente aislados: bases de datos separadas, carpetas de habilidades separadas, sin consultas entre espacios.";
"help.quickstart" = "Inicio rápido";
"help.quickstart.1.desc" = "Agrega y habilita un proveedor en Configuración → Servicios de modelos, luego prueba su punto final, modelo y clave de API.";
"help.quickstart.1.title" = "Conectar un proveedor de modelos";
"help.quickstart.2.desc" = "Life y Work mantienen bases de datos separadas. Selecciona uno en la parte superior de la barra lateral; las conversaciones, archivos, habilidades y memoria nunca se cruzan.";
"help.quickstart.2.title" = "Elegir un espacio";
"help.quickstart.3.desc" = "Describe tu tarea a %@. Inspecciona el progreso de las herramientas y revisa las operaciones cuando aparezca la confirmación.";
"help.quickstart.3.title" = "Hablar con %@";
"help.quickstart.4.desc" = "Las habilidades son paquetes SKILL.md que se pueden cargar bajo demanda. Importa uno existente o describe lo que debe hacer en el chat y deja que el agente lo redacte.";
"help.quickstart.4.title" = "Ampliar con habilidades";
