+        let certificate = try NIOSSLCertificate(bytes: .init(samplePemCert.utf8), format: .pem)
+        let bundle = NIOSSLPKCS12Bundle(certificateChain: [certificate], privateKey: privateKey)
+        let encoded = try bundle.serialize(passphrase: [UInt8]())
+        // Parsing without a password exercises the NULL-password KDF path before
+        // the library falls back to the PKCS#12 empty-string representation.
+        for passphrase in [Optional<[UInt8]>.none, Optional.some([UInt8]())] {
+            let decoded = try NIOSSLPKCS12Bundle(buffer: encoded, passphrase: passphrase)
+            XCTAssertEqual(decoded, bundle)
+        }
+        XCTAssertThrowsError(try NIOSSLPKCS12Bundle(buffer: encoded, passphrase: "incorrect".utf8))
+    }
